{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "SDKVersion": 2,
  "Author": "HiyokoDev",
  "Name": "Hiyoko Volume Mixer",
  "Category": "Hiyoko Volume Mixer",
  "CategoryIcon": "imgs/category-icon",
  "Description": "アプリの音量・ミュートを自動検出して操作する音量ミキサーです。",
  "Version": "1.0.0.0",
  "UUID": "fun.hiyoko.volumemixer",
  "Icon": "imgs/plugin-icon",
  "DisableCaching": true,
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "Profiles": [],
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "fun.hiyoko.volumemixer.app-volume",
      "Name": "アプリ音量ミキサー",
      "Icon": "imgs/action-icon",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/action-settings.html",
      "States": [
        {
          "Image": "imgs/action-icon",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UUID": "fun.hiyoko.volumemixer.apple-music",
      "Name": "Apple Music プレイリスト",
      "Tooltip": "プレイリストをシャッフル再生します。もう一度押すと一時停止・再開します。",
      "Icon": "imgs/action-icon",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/apple-music-settings.html",
      "States": [
        {
          "Image": "imgs/action-icon",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UUID": "fun.hiyoko.volumemixer.urx-mix",
      "Name": "URX22 MIX オン/オフ",
      "Tooltip": "Yamaha URX22 の MIX1 / MIX2 をオン・オフします（マイクのミュートに）。Device Center は不要です。",
      "Icon": "imgs/action-icon",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/urx-mix-settings.html",
      "States": [
        {
          "Image": "imgs/action-icon",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "UUID": "fun.hiyoko.volumemixer.restart-server",
      "Name": "音声サーバー再起動",
      "Tooltip": "内蔵の音声サーバーを再起動して、オフラインから復旧します。",
      "Icon": "imgs/action-icon",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/action-icon",
          "TitleAlignment": "middle"
        }
      ]
    }
  ]
}
